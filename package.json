  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build && node -e \"const fs=require('fs');fs.rmSync('out',{recursive:true,force:true});fs.renameSync('target/release/bundle','out')\"",
    "build:nosign": "tauri build --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}' && node -e \"const fs=require('fs');fs.rmSync('out',{recursive:true,force:true});fs.renameSync('target/release/bundle','out')\""
  },
